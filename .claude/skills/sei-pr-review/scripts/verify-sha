#!/usr/bin/env bash

set -eu -o pipefail

main() {
  if (($# > 0)) && [[ $1 == "-h" ]]; then
    cat <<'EOF'
Usage: verify-sha [-h]

Verify that the local HEAD SHA matches the remote branch SHA using `git`
only. Derives the remote branch name from the current local branch — no
arguments needed. Except with `-h`, prints exactly one of the following to
stdout for consumption by an LLM:

    VERIFY-SHA: PASS
    VERIFY-SHA: FAIL — <details>
    ERROR: <reason>

Always exits 0; the outcome is conveyed by stdout alone.

OPTIONS:
    -h          Show this help message
EOF

    return 0
  fi

  if (($# != 0)); then
    echo "ERROR: verify-sha takes no positional arguments"

    return 0
  fi

  if ! stderr_file=$(mktemp 2>&1); then
    echo "ERROR: $stderr_file"

    return 0
  fi
  trap 'rm -f "$stderr_file"' EXIT

  local branch
  if ! branch=$(git rev-parse --abbrev-ref HEAD 2>"$stderr_file"); then
    echo "ERROR: $(<"$stderr_file")"

    return 0
  fi

  local ls_remote_output
  if ! ls_remote_output=$(git ls-remote origin "refs/heads/$branch" 2>"$stderr_file"); then
    echo "ERROR: $(<"$stderr_file")"

    return 0
  fi

  # `ls-remote` matches patterns against the tail of ref names, so it can also list
  # decoys such as `refs/heads/x/refs/heads/$branch`. Keep only the exact ref.
  local remote_sha="" sha ref
  while read -r sha ref; do
    if [[ $ref == "refs/heads/$branch" ]]; then
      remote_sha=$sha
    fi
  done <<<"$ls_remote_output"

  if [[ -z $remote_sha ]]; then
    echo "VERIFY-SHA: FAIL — no remote ref found for branch $branch"

    return 0
  fi

  local local_sha
  if ! local_sha=$(git rev-parse HEAD 2>"$stderr_file"); then
    echo "ERROR: $(<"$stderr_file")"

    return 0
  fi

  if [[ $local_sha != "$remote_sha" ]]; then
    echo "VERIFY-SHA: FAIL — local $local_sha ≠ remote $remote_sha"

    return 0
  fi

  echo "VERIFY-SHA: PASS"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
