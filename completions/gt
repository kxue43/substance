_sei_gt::complete() {
  if ((COMP_CWORD == 1)) && [[ $2 == @(-|-h) ]]; then
    COMPREPLY=("-h")

    return 0
  elif ((COMP_CWORD == 1)) && [[ $2 != "" ]]; then
    compgen -V COMPREPLY -W "$(basename "$(pwd)")" -- "$2"

    return 0
  elif ((COMP_CWORD == 1)); then
    COMPREPLY=("$(basename "$(pwd)")")

    return 0
  fi

  return 0
} && complete -o bashdefault -F _sei_gt::complete gt

