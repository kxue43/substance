#!/usr/bin/env bash

set -eu -o pipefail

source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/../lib/utils.sh"

main() {
  if (($# > 0)) && [[ $1 == "-h" ]]; then
    cat <<'EOF'
Usage: claude-notify [-h]

Send a sticky macOS notification for a Claude Code hook event, with the
worktree directory name and current git branch folded into the message.
Reads Claude Code's hook JSON payload from stdin.

OPTIONS:
    -h    Show this help message
EOF

    return 0
  fi

  local stdin_json
  stdin_json="$(cat)"

  local cwd
  cwd="$(jq -r '.cwd // empty' <<<"$stdin_json" 2>/dev/null || true)"
  [[ -n "$cwd" ]] || cwd="${CLAUDE_PROJECT_DIR:-$PWD}"

  local dir_name branch reason message

  dir_name="$(basename "$cwd")"
  branch="$(git -C "$cwd" branch --show-current 2>/dev/null || echo "no-branch")"
  reason="$(jq -r '.message // "ready for prompt"' <<<"$stdin_json" 2>/dev/null || echo "ready for prompt")"
  message="[${dir_name} · ${branch}] ${reason}"

  terminal-notifier \
    -title "Claude Code" \
    -message "$message" \
    -sticky \
    >/dev/null
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
